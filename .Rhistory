library(rvest)
library(dplyr)
library(stringr)
# 1. Define department abbreviations for all 7 FSB departments
dept_abbr = c("accountancy", "economics", "entrepreneurship", "finance", "isa", "management", "marketing")
# 2. Initialize an empty container data frame
faculty_df = data.frame()
# 3. Loop through each department, scrape information, and append to container
for (dept in dept_abbr) {
cat(rep("-", 25), "\n")
print(dept)
# Construct the directory URL dynamically
dept_url = paste0("https://miamioh.edu/fsb/academics/", dept, "/faculty-staff/index.html")
# Read the HTML content
webpage = rvest::read_html(dept_url)
# Select all table rows inside #sidebar-main (matches Dr. Megahed's selector structure)
rows = webpage |> rvest::html_elements("#sidebar-main table tr, table tr")
# Extract per row using singular html_element to prevent length mismatch errors
names = rows |>
rvest::html_element("td:nth-child(1) strong, td:nth-child(1) a, td strong") |>
rvest::html_text2() |>
stringr::str_to_title()
positions = rows |>
rvest::html_element("td:nth-child(2), td i, .title") |>
rvest::html_text2()
websites = rows |>
rvest::html_element("td:nth-child(1) a, td strong a, a") |>
rvest::html_attr("href") |>
rvest::url_absolute(dept_url)
# Keep only rows that have a valid faculty name
valid = !is.na(names) & names != "" & !names %in% c("Name", "Faculty/Staff Name")
if (any(valid)) {
# Build data frame for the current department (keeping dept lowercase)
df = data.frame(
department = dept,
name = names[valid],
position = positions[valid],
website = websites[valid],
stringsAsFactors = FALSE
)
# Print the first extracted name to monitor loop progress
df$name[1] |> print()
# Append to the main container data frame
faculty_df = rbind(faculty_df, df)
}
cat(rep("-", 25), "\n")
}
# 4. Print the first few observations for grading
head(faculty_df)
library(rvest)
library(dplyr)
library(stringr)
# 1. Define department names matching Miami's directory query format
dept_list = c("Accountancy", "Economics", "Entrepreneurship", "Finance", "Information Systems and Analytics", "Management", "Marketing")
# Map long names back to short abbreviations for your department column
dept_abbr = c("accountancy", "economics", "entrepreneurship", "finance", "isa", "management", "marketing")
# 2. Initialize container
faculty_df = data.frame()
# 3. Loop through departments
for (i in seq_along(dept_list)) {
current_dept_name = dept_list[i]
current_abbr = dept_abbr[i]
cat(rep("-", 25), "\n")
print(current_abbr)
# Construct URL using Miami's query structure (URL-encode spaces for ISA)
dept_query = URLencode(current_dept_name)
dept_url = paste0("https://miamioh.edu/fsb/directory/?up=/query/all/all/", dept_query, "/all")
# Read page HTML
webpage = rvest::read_html(dept_url)
# Select table rows inside the main directory table
rows = webpage |> rvest::html_elements("#sidebar-main table tr, .directory-table tr, table tr")
# Extract per row (singular html_element prevents length mismatch errors)
names = rows |>
rvest::html_element("td strong a, td a, td:nth-child(1)") |>
rvest::html_text2() |>
stringr::str_to_title()
positions = rows |>
rvest::html_element("td:nth-child(2), td i") |>
rvest::html_text2()
websites = rows |>
rvest::html_element("td strong a, td a") |>
rvest::html_attr("href") |>
rvest::url_absolute(dept_url)
# Filter out table header rows or empty rows
valid = !is.na(names) & names != "" & !names %in% c("Name", "Faculty/Staff", "Faculty & Staff Name")
if (any(valid)) {
df = data.frame(
department = current_abbr,
name = names[valid],
position = positions[valid],
website = websites[valid],
stringsAsFactors = FALSE
)
# Print the first extracted professor's name to show console progress
df$name[1] |> print()
# Append
faculty_df = rbind(faculty_df, df)
}
cat(rep("-", 25), "\n")
}
